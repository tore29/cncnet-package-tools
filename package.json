{
  "name": "cncnet-package-tools",
  "private": true,
  "type": "module",
  "description": "Shared build / packing / installer tooling for the CnCNet game client packages (submodule of the ts, yr, ra, td repos)",
  "author": "",
  "license": "ISC",
  "workspaces": [
    "core",
    "build-installer",
    "ladder-maps-sync",
    "map-name-case-fix",
    "mix-packer",
    "mpmaps-updater",
    "publish-release",
    "release-asset-uploader",
    "release-tag-validator",
    "version-writer"
  ],
  "scripts": {
    "build-installer": "npm run start --workspace build-installer --",
    "ladder-maps-sync": "npm run start --workspace ladder-maps-sync",
    "map-name-case-fix": "npm run start --workspace map-name-case-fix --",
    "mpmaps-updater": "npm run start --workspace mpmaps-updater --",
    "mix-packer": "npm run start --workspace mix-packer --",
    "version-writer": "npm run start --workspace version-writer --",
    "release-tag-validator": "npm run start --workspace release-tag-validator",
    "test-release-tag-validator": "npm run test --workspace release-tag-validator",
    "release-asset-uploader": "npm run start --workspace release-asset-uploader --",
    "test-release-asset-uploader": "npm run test --workspace release-asset-uploader",
    "publish-release": "npm run start --workspace publish-release --",
    "test-publish-release": "npm run test --workspace publish-release"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">= 24"
  }
}
